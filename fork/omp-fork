#!/usr/bin/env bash
# omp-fork: keep a locally built omp = latest upstream release + this fork's patches.
# It installs as `omp-dev`, next to the stock `omp`, which it never touches.
#
#   omp-fork update   rebase the patch branch onto the newest upstream release tag,
#                     test, build the standalone binary, install it, push the branch
#   omp-fork install  rebuild and install the branch as it is (no fetch, no rebase)
#   omp-fork status   installed build, patch series, newest upstream release
#   omp-fork setup    install this script and the omp-fork systemd user timer
#   omp-fork resolve TAG  (internal) run the conflict-resolving agent for TAG
#
# The rebase runs on a detached HEAD; the branch only moves after the new binary
# built, passed its gates, and is installed. Any failure leaves the installed build
# and the branch untouched and sends a notification. A rebase conflict also starts
# an agent (once per target tag) in the transient unit omp-fork-resolve to redo the
# rebase by hand and finish with `omp-fork update`.
set -euo pipefail

REPO="${OMP_FORK_REPO:-$HOME/projects/open-source/.worktrees/oh-my-pi_fork-stable}"
BRANCH="${OMP_FORK_BRANCH:-tony/stable}"
UPSTREAM="${OMP_FORK_UPSTREAM_REMOTE:-upstream}"
ORIGIN="${OMP_FORK_ORIGIN_REMOTE:-origin}"
PREFIX="${OMP_FORK_PREFIX:-$HOME/.local/lib/omp-fork}"
BIN="${OMP_FORK_BIN:-$HOME/.local/bin/omp-dev}"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omp-fork"
NOTIFY_TO="${OMP_FORK_NOTIFY_TO:-195550206}"
KEEP_BUILDS=3
RESOLVE_UNIT=omp-fork-resolve
# Headless agent that resolves rebase conflicts; the prompt is appended.
RESOLVER=(agent run -p personal omp --auto-approve -p)

log() { printf 'omp-fork: %s\n' "$*" >&2; }

notify() {
	log "$1"
	command -v agent-notify >/dev/null || return 0
	agent-notify send --backend telegram-bot --markdown --to "$NOTIFY_TO" "*omp-fork*: $1" >/dev/null 2>&1 ||
		log "notification failed"
}

die() {
	notify "$1"
	exit 1
}

git_() { git -C "$REPO" "$@"; }

# The newest vX.Y.Z tag whose prebuilt natives are on npm. Upstream sometimes tags a
# version it never publishes; waiting on that tag would stall the fork forever.
latest_release_tag() {
	local published
	published=$(npm view @oh-my-pi/pi-natives-linux-x64 versions --json 2>/dev/null |
		jq -r '[.] | flatten | join(" ")') || return 1
	# Read all input: an early exit (head/grep -m1) SIGPIPEs git and pipefail aborts.
	git_ tag -l 'v[0-9]*' --sort=-v:refname | awk -v published="$published" '
		BEGIN { n = split(published, v, " "); for (i = 1; i <= n; i++) ok["v" v[i]] = 1 }
		/^v[0-9]+\.[0-9]+\.[0-9]+$/ && ($0 in ok) && !found { print; found = 1 }
		END { exit !found }'
}

# The release tag the branch currently sits on.
base_tag() {
	git_ describe --tags --abbrev=0 --match 'v[0-9]*.[0-9]*.[0-9]*' --exclude '*-*' "$1"
}

installed_build() {
	[[ -L "$BIN" ]] || return 0
	basename "$(dirname "$(readlink "$BIN")")"
}

# Puts the prebuilt native addons for the checked-out version in place, unless the
# fork patches native code, in which case they must be compiled.
prepare_natives() {
	local base=$1 version tmp
	version=$(jq -r .version "$REPO/packages/natives/package.json")
	if ! git_ diff --quiet "$base" HEAD -- crates packages/natives; then
		log "patches touch native code; compiling natives"
		(cd "$REPO" && bun run build:native)
		return
	fi
	tmp=$(mktemp -d)
	(cd "$tmp" && npm pack --silent "@oh-my-pi/pi-natives-linux-x64@$version" >/dev/null) ||
		{ rm -rf "$tmp"; return 1; }
	tar -xzf "$tmp"/*.tgz -C "$tmp"
	# Rename over the destination, never write into it: if the destination is a link
	# into an installed omp, an in-place write rewrites the addon every running omp
	# has mapped and crashes them all (SIGSEGV/SIGBUS).
	local addon dest
	for addon in "$tmp"/package/pi_natives.linux-x64-*.node; do
		dest="$REPO/packages/natives/native/$(basename "$addon")"
		cp "$addon" "$dest.omp-fork-tmp" && mv -f "$dest.omp-fork-tmp" "$dest" || { rm -rf "$tmp"; return 1; }
	done
	rm -rf "$tmp"
}

# Builds HEAD and installs it. Prints the installed build id.
build_and_install() {
	local base=$1 version sha id dest
	version=$(jq -r .version "$REPO/packages/coding-agent/package.json")
	sha=$(git_ rev-parse --short=10 HEAD)
	id="$version-$sha"

	# Callers run this under `if !`/`||`, where errexit is off: check every step.
	(cd "$REPO" && bun install --frozen-lockfile) >&2 || return 1
	prepare_natives "$base" >&2 || return 1
	(cd "$REPO/packages/coding-agent" && bun run check:types && bun test test/collab) >&2 || return 1
	(cd "$REPO/packages/coding-agent" && bun run build) >&2 || return 1

	local built="$REPO/packages/coding-agent/dist/omp" reported
	reported=$("$built" --version) || return 1
	[[ "$reported" == "omp/$version" ]] || { log "built binary reports '$reported', expected omp/$version"; return 1; }

	dest="$PREFIX/$id"
	mkdir -p "$dest" "$(dirname "$BIN")" || return 1
	cp "$built" "$dest/omp.tmp" && mv -f "$dest/omp.tmp" "$dest/omp" || return 1
	ln -sfn "$dest/omp" "$BIN.omp-fork-tmp" && mv -Tf "$BIN.omp-fork-tmp" "$BIN" || return 1
	install -m 0755 "$REPO/fork/omp-fork" "$HOME/.local/bin/omp-fork" || return 1

	# Running sessions keep their own inode; older builds are only disk space.
	find "$PREFIX" -mindepth 1 -maxdepth 1 -type d -printf '%T@ %p\n' | sort -rn |
		tail -n +$((KEEP_BUILDS + 1)) | cut -d' ' -f2- | while read -r old; do
		[[ "$old" == "$dest" ]] || rm -rf "$old"
	done

	mkdir -p "$STATE_DIR"
	printf 'build=%s\nbase=%s\ncommit=%s\ninstalled_at=%s\n' "$id" "$base" "$(git_ rev-parse HEAD)" \
		"$(date -Is)" >"$STATE_DIR/state"
	printf '%s\n' "$id"
}

require_clean() {
	[[ -z "$(git_ status --porcelain --untracked-files=no)" ]] || die "$REPO has uncommitted changes; not touching it"
	[[ "$(git_ branch --show-current)" == "$BRANCH" ]] || die "$REPO is not on $BRANCH"
}

cmd_update() {
	require_clean
	git_ fetch -q --tags "$UPSTREAM" || die "fetching $UPSTREAM failed"
	git_ fetch -q "$ORIGIN" || log "fetching $ORIGIN failed; continuing"

	local base latest target id
	base=$(base_tag "$BRANCH")
	latest=$(latest_release_tag) || die "no upstream release tag with natives on npm (npm unreachable?)"
	target=$base

	if [[ "$latest" != "$base" ]]; then
		if git_ merge-base --is-ancestor "$base" "$latest"; then
			target=$latest
		else
			log "newest tag $latest does not descend from $base; staying on $base"
		fi
	fi
	if [[ "$target" == "$base" && "$(installed_build)" == "$(jq -r .version "$REPO/packages/coding-agent/package.json")-$(git_ rev-parse --short=10 "$BRANCH")" ]]; then
		log "up to date: $(installed_build) on $base"
		return 0
	fi

	git_ checkout -q --detach "$BRANCH"
	if [[ "$target" != "$base" ]]; then
		log "rebasing $BRANCH from $base onto $target"
		if ! git_ rebase -q --empty=drop --onto "$target" "$base"; then
			git_ rebase --abort || true
			git_ checkout -q "$BRANCH"
			start_resolver "$target"
			exit 1
		fi
	fi

	if ! id=$(build_and_install "$target"); then
		git_ checkout -q -f "$BRANCH"
		die "building $target + patches failed; still running $(installed_build)"
	fi
	git_ checkout -q -B "$BRANCH"
	git_ push -q --force-with-lease "$ORIGIN" "$BRANCH" || log "pushing $BRANCH failed"
	if [[ "$target" != "$base" ]]; then
		notify "installed omp $id ($target + $(git_ rev-list --count "$target..$BRANCH") patches)"
	else
		log "installed omp $id"
	fi
}

# Hands a conflicting rebase to an agent in a transient unit, so this run (and its
# lock, which the agent's own `omp-fork update` needs) ends right away. Attempts
# each target tag once: a failed attempt waits for a human or a newer tag.
start_resolver() {
	local target=$1 marker="$STATE_DIR/resolve-target" args=() var
	if [[ "$(cat "$marker" 2>/dev/null)" == "$target" ]]; then
		die "rebasing the patches onto $target conflicts and the agent already tried; resolve by hand in $REPO (still running $(installed_build))"
	fi
	printf '%s\n' "$target" >"$marker"
	for var in PATH XDG_STATE_HOME ${!OMP_FORK_@}; do
		[[ -n "${!var:-}" ]] && args+=("--setenv=$var=${!var}")
	done
	if systemd-run --user --quiet --collect --unit="$RESOLVE_UNIT" --property=RuntimeMaxSec=2h \
		--property=Nice=10 "${args[@]}" -- "$(readlink -f "$0")" resolve "$target"; then
		notify "rebasing the patches onto $target conflicts; an agent is resolving it (journalctl --user -u $RESOLVE_UNIT); still running $(installed_build)"
	else
		rm -f "$marker"
		die "rebasing the patches onto $target conflicts and the agent could not start; resolve by hand in $REPO (still running $(installed_build))"
	fi
}

resolve_prompt() {
	local target=$1 base
	base=$(base_tag "$BRANCH")
	cat <<-EOF
	omp-fork (our omp fork updater, script $REPO/fork/omp-fork, docs $REPO/fork/README.md) failed to rebase branch $BRANCH from $base onto upstream release $target: the rebase conflicts. Read memory/omp-fork.md first. Resolve it end to end, unattended:

	1. In $REPO, on a detached HEAD exactly like the script: git checkout --detach $BRANCH && git rebase --empty=drop --onto $target $base
	2. Resolve every conflict by understanding what upstream changed (git log/diff $base..$target on the conflicting files) and what our patch intends. Keep upstream's design and re-express our patch on top of it; never drop a patch's behavior to get a clean merge. Where upstream changed an API our patch relies on, adapt both call sites and tests, and add a test when our behavior now travels a new code path.
	3. After each resolved commit, and at the end: cd packages/coding-agent && bun run check:types && bun test test/collab. All must pass.
	4. Finish with: git checkout -B $BRANCH && omp-fork update. That builds, installs, and pushes; it must log "installed omp".
	5. If upstream changed the fork in a way future rebases should know, add a short dated line to memory/omp-fork.md.

	If you cannot resolve it correctly, run git rebase --abort && git checkout $BRANCH in $REPO so the worktree is clean, and explain why. End your reply with a summary of each conflict and how you resolved it.
	EOF
}

# Runs inside $RESOLVE_UNIT; reports the outcome from the repo state, not the agent's word.
cmd_resolve() {
	local target=${1:?usage: omp-fork resolve TAG} status=0 expected
	export OMP_FORK_RESOLVING=1
	"${RESOLVER[@]}" "$(resolve_prompt "$target")" || status=$?
	expected="$(jq -r .version "$REPO/packages/coding-agent/package.json")-$(git_ rev-parse --short=10 "$BRANCH")"
	if [[ "$(git_ branch --show-current)" == "$BRANCH" && -z "$(git_ status --porcelain --untracked-files=no)" &&
		"$(base_tag "$BRANCH")" == "$target" && "$(installed_build)" == "$expected" ]]; then
		notify "the agent rebased onto $target and installed omp $expected ($(git_ rev-list --count "$target..$BRANCH") patches)"
	else
		die "the agent did not finish rebasing onto $target (exit $status); resolve by hand in $REPO (journalctl --user -u $RESOLVE_UNIT; still running $(installed_build))"
	fi
}

cmd_install() {
	require_clean
	local id
	id=$(build_and_install "$(base_tag HEAD)") || die "building $BRANCH failed; still running $(installed_build)"
	log "installed omp $id"
}

cmd_status() {
	local base
	base=$(base_tag "$BRANCH")
	printf 'installed: %s -> %s\n' "$(installed_build)" "$(readlink "$BIN" 2>/dev/null || echo none)"
	printf 'branch:    %s on %s (%s)\n' "$BRANCH" "$base" "$REPO"
	git_ log --format='  %h %s' "$base..$BRANCH"
	git_ fetch -q --tags "$UPSTREAM" 2>/dev/null || log "fetching $UPSTREAM failed; showing local tags"
	printf 'upstream:  %s\n' "$(latest_release_tag || echo unknown)"
}

cmd_setup() {
	local units="$HOME/.config/systemd/user"
	install -Dm 0755 "$REPO/fork/omp-fork" "$HOME/.local/bin/omp-fork"
	install -Dm 0644 "$REPO/fork/systemd/omp-fork.service" "$units/omp-fork.service"
	install -Dm 0644 "$REPO/fork/systemd/omp-fork.timer" "$units/omp-fork.timer"
	systemctl --user daemon-reload
	systemctl --user enable omp-fork.timer
	# A running timer keeps its old schedule until restarted.
	systemctl --user restart omp-fork.timer
}

main() {
	local cmd=${1:-help}
	case "$cmd" in
	update | install)
		mkdir -p "$STATE_DIR"
		# While the agent works, the worktree sits mid-rebase; only its own runs may touch it.
		if [[ -z "${OMP_FORK_RESOLVING:-}" ]] && systemctl --user -q is-active "$RESOLVE_UNIT"; then
			log "an agent is resolving a rebase conflict ($RESOLVE_UNIT); skipping"
			exit 0
		fi
		exec 9>"$STATE_DIR/lock"
		flock -n 9 || { log "another omp-fork run holds the lock"; exit 0; }
		"cmd_$cmd"
		;;
	resolve) cmd_resolve "${@:2}" ;;
	status | setup) "cmd_$cmd" ;;
	*) sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//'; [[ "$cmd" == help || "$cmd" == -h || "$cmd" == --help ]] ;;
	esac
}

main "$@"
